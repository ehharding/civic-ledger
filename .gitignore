# Dependencies & Build Output
.next/
node_modules/
coverage/
out/
output/
playwright-report/
test-results/

# Local Secrets & Environment Overrides
# `.env*` already covers `.env`, `.env.local`, and `.env.<mode>.local`; the checked-in template is the one exception.
.env*
!.env.example

# Local Tooling
.DS_Store
.vercel
*.tsbuildinfo

# This project standardizes on pnpm (see "packageManager" in package.json and pnpm-lock.yaml) — a stray npm/yarn
# lockfile from an accidental `npm install` would drift out of sync with it and shouldn't be committed.
package-lock.json
yarn.lock

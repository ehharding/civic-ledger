# Dependencies & Build Output
.next/
node_modules/
coverage/
out/
output/
playwright-report/
test-results/

# Regenerated by Next on every `next dev` and `next build`, and rewritten to point at a *different* types directory by
# each of them — so committing it means `pnpm build` after `pnpm dev` produces a diff that says nothing. It is also not
# load-bearing here: tsconfig.json's `include` already names `.next/dev/types` and `.next/types` directly, and
# `pnpm typecheck` passes on a clean checkout with neither this file nor `.next/` present.
next-env.d.ts

# Local Secrets & Environment Overrides
# `.env*` already covers `.env`, `.env.local`, and `.env.<mode>.local`; the checked-in template is the one exception.
.env*
!.env.example

# Local Tooling
.DS_Store
.vercel
*.tsbuildinfo

# `.claude/launch.json` is checked in — it names how to run this app, which is a project fact (see CONTRIBUTING). The
# machine-local settings file that sits beside it is not.
.claude/settings.local.json

# This project standardizes on pnpm (see "packageManager" in package.json and pnpm-lock.yaml) — a stray npm/yarn
# lockfile from an accidental `npm install` would drift out of sync with it and shouldn't be committed.
package-lock.json
yarn.lock

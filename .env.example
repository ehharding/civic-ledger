# Server-only. Never prefix this value with NEXT_PUBLIC_.
CONGRESS_API_KEY=

# Required only when persistence is enabled.
DATABASE_URL=

# The canonical origin, with no trailing slash — e.g., `https://civic-ledger.example`. Feeds every canonical URL, Open
# Graph tag, the sitemap, and robots.txt (`getSiteUrl` in src/lib/site.ts). Leave it empty locally, where the fallback
# is an obviously fake placeholder. **Set it on any custom-domain deployment**: unset there, every canonical URL
# silently names the `*.vercel.app` host. See docs/deployment.md.
NEXT_PUBLIC_SITE_URL=

# Error reporting. Unset keeps Sentry off, the normal state for a local checkout. NEXT_PUBLIC_ on purpose, unlike
# CONGRESS_API_KEY: the browser must know where to report, and a DSN is a write-only ingest address.
NEXT_PUBLIC_SENTRY_DSN=

# Deployment-only; leave empty locally ("development", and a 0.1 sample rate). On a deployment, set the environment
# explicitly (`production` / `preview`); see "Error Reporting" in docs/deployment.md.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Build-time only, for the source-map upload; not needed locally. On a deployment they live in the *GitHub* Actions
# settings, not Vercel's, since `vercel build` runs inside the runner. See docs/deployment.md.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

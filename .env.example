# Server-only. Never prefix this value with NEXT_PUBLIC_.
CONGRESS_API_KEY=

# Required only when persistence is enabled.
DATABASE_URL=

# Error reporting. Leave the DSN unset to keep Sentry switched off entirely, which is the normal state for a local
# checkout — an unset DSN keeps your own stack traces out of the shared project's issue stream.
#
# The DSN is NEXT_PUBLIC_ on purpose, unlike CONGRESS_API_KEY: the browser has to know where to report to, and a DSN is
# a write-only ingest address rather than a credential that can read anything back.
NEXT_PUBLIC_SENTRY_DSN=

# Both are for deployments, and both are correct left empty here. The fallbacks are what a local checkout wants:
# "development" for the environment, and 0.1 for the sample rate. Filling either one in locally only pins a value you
# would then have to remember to change.
#
# On the deployment, set the environment explicitly (`production` / `preview`) rather than relying on the fallback —
# see the "Error Reporting" section of docs/deployment.md for why. The sample rate is genuinely optional there too.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Build-time only, and read solely to upload source maps. You do not need any of these locally: `pnpm dev` never uses
# them (the Sentry build step is skipped outside a production build), and a local `pnpm build` skips the upload without
# a token anyway. They are listed here to say the names exist, not to ask you to fill them in.
#
# On the deployment they live in the *GitHub* Actions settings rather than in Vercel, since `vercel build` runs the
# build inside the runner: the token as a secret, the two slugs as plain variables. @see docs/deployment.md.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

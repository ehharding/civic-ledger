# Server-only. Never prefix this value with NEXT_PUBLIC_.
CONGRESS_API_KEY=

# Required only when persistence is enabled. Without it the app runs exactly as it always has: live reads with a preview
# fallback, and no stored copy. See docs/deployment.md.
DATABASE_URL=

# Required only to enable scheduled ingestion. POST /api/ingest refuses to run at all when this is unset rather than
# defaulting open — an unauthenticated write endpoint is worse than an absent one.
CRON_SECRET=

{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.next",
      "!!**/coverage",
      "!!**/node_modules",
      "!!**/out",
      "!!**/output",
      "!!**/playwright-report",
      "!!**/test-results"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  // Each rule beyond `recommended` enforces a convention the tree already follows. Two that look like obvious additions
  // are deliberately left off:
  //   - `style/noInferrableTypes` contradicts the house style of annotating every `const x: string = "…"`.
  //   - `suspicious/noUnnecessaryConditions` doesn't model `noUncheckedIndexedAccess`, so it flags required guards.
  //
  // Biome has no flag that fails on `info` diagnostics, and a group can't take a blanket severity alongside per-rule
  // entries, so every recommended rule that defaults to `info` is listed in its group as an error. Biome adds such
  // rules in minor releases: after a bump, list any new ones (`biome explain <rule>` shows "Default severity: info").
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Off: tsconfig's `noPropertyAccessFromIndexSignature` requires bracket access on index signatures (that's
        // what makes a misspelled env var fail to compile — see env.d.ts), and this rule would "fix" those back into
        // type errors.
        "useLiteralKeys": "off",
        // `.test()` over `.exec()`/`.match()` when only the boolean is used.
        "useRegexpTest": "error",

        // Recommended rules that default to `info`, which `pnpm lint` prints without failing. See the note above.
        "noExtraBooleanCast": "error",
        "noFlatMapIdentity": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessStringRaw": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefinedInitialization": "error",
        "useFlatMap": "error",
        "useIndexOf": "error"
      },
      "correctness": {
        // Importing a transitive dependency breaks whenever the package that pulls it in changes its range.
        "noUndeclaredDependencies": "error",

        // Recommended rules that default to `info`, which `pnpm lint` prints without failing. See the note above.
        "useParseIntRadix": "error"
      },
      "nursery": {
        // Unstable by definition, but a nursery rule that changes fails CI loudly rather than quietly.

        // Monkey-patching a builtin is invisible from every file that depends on the patch.
        "noExtendNative": "error",
        // An unawaited promise swallows its own rejection.
        "noFloatingPromises": "error",
        // e.g., an async `.filter()` predicate, whose returned promise is always truthy.
        "noMisusedPromises": "error",
        // `await` on a non-thenable is either a stray keyword or a signature that changed underneath the caller.
        "useAwaitThenable": "error",
        // The compiler only catches a missing `case` when the switch has no `default`.
        "useExhaustiveSwitchCases": "error",
        // `.includes()` over `.indexOf(x) !== -1`.
        "useIncludes": "error",
        // `??` over `||`, since `0` and `""` are real values here (a zero count, an empty query).
        "useNullishCoalescing": "error",
        // `.startsWith()`/`.endsWith()` over an index comparison or a slice.
        "useStringStartsEndsWith": "error",
        // An inferred return type is a signature that changes silently when the body does.
        "useExplicitReturnType": "error",

        // Recommended rules that default to `info`, which `pnpm lint` prints without failing. See the note above.
        "noInvalidPropertyInitValue": "error",
        "noMagicArrayFlatDepth": "error",
        "noNegatedArrayPredicate": "error",
        "noReturnInFinally": "error",
        "noScssNullComparison": "error",
        "noUnnecessaryStringTrim": "error",
        "noUselessCall": "error",
        "noUselessLengthCheck": "error",
        "noUselessSpread": "error",
        "noZeroLengthUnit": "error",
        "useBlockStatementOverIife": "error",
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error",
        "useSimplifiedBooleanReturn": "error",
        "useSingleTopLevelHeading": "error",
        "useWhileLoopCondition": "error"
      },
      "style": {
        // `value === 0`, not `0 === value`.
        "noYodaExpression": "error",
        // A lone `if` inside an `if` is one condition wearing two.
        "useCollapsedIf": "error",
        // `T[]` and `readonly T[]`, never `Array<T>` — the spelling every model in `src/lib` already uses.
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "shorthand" }
        },
        // `type`, never `interface`: a second declaration of a model should be an error, not a silent merge.
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        },
        // A rethrow that drops `cause` throws away the diagnosis (Node's `fetch` keeps it one level down).
        "useErrorCause": "error",
        // `throw new Error(…)`, never `throw Error(…)`.
        "useThrowNewError": "error",
        // `beforeEach` and friends before the tests they set up, so a suite reads top to bottom.
        "useTestHooksOnTop": "error",

        // Recommended rules that default to `info`, which `pnpm lint` prints without failing. See the note above.
        "useArrayLiterals": "error",
        "useExponentiationOperator": "error",
        "useNodejsImportProtocol": "error",
        "useShorthandFunctionType": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        // A duplicated `beforeEach` runs twice and reads as one.
        "noDuplicateTestHooks": "error",
        // An implicitly-`any` variable that gains its type from first assignment defeats `strict` without saying so.
        "noEvolvingTypes": "error",
        // `it.only` / `describe.only` left in a file turns a green suite into a green *subset* of one.
        "noFocusedTests": "error",
        // Guards the layering in `docs/architecture.md`: models → transport → components, never back.
        "noImportCycles": "error",
        // A skipped test is a coverage gap that reports as a pass.
        "noSkippedTests": "error",
        // `new Error()` with no message reaches an operator as a stack and nothing else.
        "useErrorMessage": "error",

        // Recommended rules that default to `info`, which `pnpm lint` prints without failing. See the note above.
        "noDuplicateFields": "error",
        "noQuickfixBiome": "error"
      }
    }
  },
  "overrides": [
    {
      // Ambient declarations (e.g., env.d.ts) augment types this project doesn't own, which only `interface` can do.
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": { "style": { "useConsistentTypeDefinitions": "off" } }
      }
    },
    {
      // Vitest suites use `it`; Playwright specs use `test`, its own idiom.
      "includes": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTestIt": {
              "level": "error",
              "options": { "function": "it", "withinDescribe": "it" }
            }
          }
        }
      }
    },
    {
      // CONTRIBUTING: inside `src/`, import with the `@/` alias, never a relative path. `tests/e2e/` and `scripts/`
      // can't resolve the alias, so they stay out of scope.
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "Import with the `@/` alias, so the file can move without touching its imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // CONTRIBUTING: the pure, isomorphic modules must not import anything server-side, or a client component that
      // imports them drags the adapter, and the API key it reads, into the browser bundle. An allowlist rather than a
      // denylist, so a new fetching module is out of bounds without anyone remembering to list it. Comes after the
      // `src/**` override, whose options this one replaces — and whose relative-path ban the allowlist already covers.
      "includes": [
        "src/lib/format.ts",
        "src/lib/congress/*/model.ts",
        "src/lib/congress/*/filter.ts",
        "src/lib/congress/directory-filter.ts",
        "src/lib/congress/bills/search.ts",
        "src/lib/congress/committees/records.ts",
        "src/lib/congress/members/seating.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!@/lib/format",
                      "!@/lib/api-contract",
                      "!@/lib/congress/*/model",
                      "!@/lib/congress/*/filter",
                      "!@/lib/congress/directory-filter",
                      "!@/lib/congress/congress-history",
                      "!@/lib/congress/current-congress",
                      "!@/lib/congress/committees/records"
                    ],
                    "message": "A pure, isomorphic module imports only other pure modules, so the browser can import it."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  // Enforces CONTRIBUTING's import grouping: builtins, packages, then `@/` app imports. `:PATH:` is last for
  // `tests/e2e/` and `scripts/`; inside `src/` it stays empty, which the `src/**` override's `noRestrictedImports`
  // enforces.
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":PACKAGE_WITH_PROTOCOL:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.next",
      "!!**/coverage",
      "!!**/node_modules",
      "!!**/out",
      "!!**/output",
      "!!**/playwright-report",
      "!!**/test-results"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  // Each rule beyond `recommended` enforces a convention the tree already follows. Two that look like obvious additions
  // are deliberately left off:
  //   - `style/noInferrableTypes` contradicts the house style of annotating every `const x: string = "…"`.
  //   - `suspicious/noUnnecessaryConditions` doesn't model `noUncheckedIndexedAccess`, so it flags required guards.
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Off: tsconfig's `noPropertyAccessFromIndexSignature` requires bracket access on index signatures (that's
        // what makes a misspelled env var fail to compile — see env.d.ts), and this rule would "fix" those back into
        // type errors.
        "useLiteralKeys": "off",
        // `.test()` over `.exec()`/`.match()` when only the boolean is used.
        "useRegexpTest": "error"
      },
      "correctness": {
        // Importing a transitive dependency breaks whenever the package that pulls it in changes its range.
        "noUndeclaredDependencies": "error"
      },
      "nursery": {
        // Unstable by definition, but a nursery rule that changes fails CI loudly rather than quietly.

        // Monkey-patching a builtin is invisible from every file that depends on the patch.
        "noExtendNative": "error",
        // An unawaited promise swallows its own rejection.
        "noFloatingPromises": "error",
        // e.g., an async `.filter()` predicate, whose returned promise is always truthy.
        "noMisusedPromises": "error",
        // `await` on a non-thenable is either a stray keyword or a signature that changed underneath the caller.
        "useAwaitThenable": "error",
        // The compiler only catches a missing `case` when the switch has no `default`.
        "useExhaustiveSwitchCases": "error",
        // `.includes()` over `.indexOf(x) !== -1`.
        "useIncludes": "error",
        // `??` over `||`, since `0` and `""` are real values here (a zero count, an empty query).
        "useNullishCoalescing": "error",
        // `.startsWith()`/`.endsWith()` over an index comparison or a slice.
        "useStringStartsEndsWith": "error",
        // An inferred return type is a signature that changes silently when the body does.
        "useExplicitReturnType": "error"
      },
      "style": {
        // `value === 0`, not `0 === value`.
        "noYodaExpression": "error",
        // A lone `if` inside an `if` is one condition wearing two.
        "useCollapsedIf": "error",
        // `T[]` and `readonly T[]`, never `Array<T>` — the spelling every model in `src/lib` already uses.
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "shorthand" }
        },
        // `type`, never `interface`: a second declaration of a model should be an error, not a silent merge.
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        },
        // A rethrow that drops `cause` throws away the diagnosis (Node's `fetch` keeps it one level down).
        "useErrorCause": "error",
        // `throw new Error(…)`, never `throw Error(…)`.
        "useThrowNewError": "error",
        "useTestHooksOnTop": "error"
      },
      "suspicious": {
        // A duplicated `beforeEach` runs twice and reads as one.
        "noDuplicateTestHooks": "error",
        // An implicitly-`any` variable that gains its type from first assignment defeats `strict` without saying so.
        "noEvolvingTypes": "error",
        // `it.only` / `describe.only` left in a file turns a green suite into a green *subset* of one.
        "noFocusedTests": "error",
        // Guards the layering in `docs/architecture.md`: models → transport → components, never back.
        "noImportCycles": "error",
        // A skipped test is a coverage gap that reports as a pass.
        "noSkippedTests": "error",
        // `new Error()` with no message reaches an operator as a stack and nothing else.
        "useErrorMessage": "error"
      }
    }
  },
  "overrides": [
    {
      // Ambient declarations (e.g., env.d.ts) augment types this project doesn't own, which only `interface` can do.
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": { "style": { "useConsistentTypeDefinitions": "off" } }
      }
    },
    {
      // Vitest suites use `it`; Playwright specs use `test`, its own idiom.
      "includes": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTestIt": {
              "level": "error",
              "options": { "function": "it", "withinDescribe": "it" }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  // Enforces CONTRIBUTING's import grouping: builtins, packages, then `@/` app imports. `:PATH:` is last and should
  // stay empty, so a stray relative import lands visibly at the bottom.
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":PACKAGE_WITH_PROTOCOL:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  }
}
